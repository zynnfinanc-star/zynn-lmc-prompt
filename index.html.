    </div>
  </main>

  <script>
    const confirmButton =
      document.getElementById("confirmButton");
    const unlockArea =
      document.getElementById("unlockArea");
    const status =
      document.getElementById("status");

    confirmButton.addEventListener("click", () => {
      unlockArea.style.display = "block";
      confirmButton.textContent = "✓ KONFIRMASI DITERIMA";
      confirmButton.disabled = true;
      status.textContent =
        "Akses dibuka berdasarkan konfirmasi Anda. " +
