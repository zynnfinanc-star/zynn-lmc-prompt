    <section class="features">
      <div class="feature">
        <span class="check">✦</span>
        <span>Prompt restorasi foto profesional</span>
      </div>
      <div class="feature">
        <span class="check">✦</span>
        <span>Fokus pada detail dan realisme</span>
      </div>
      <div class="feature">
        <span class="check">✦</span>
        <span>Link prompt langsung ke ChatGPT</span>
      </div>
